# Copier en .env puis adapter selon l'environnement (dev / test / prod)
APP_ENV=dev
LOG_LEVEL=INFO
MODEL_VERSION=1.0.0
PREDICTION_THRESHOLD=0.5
API_PORT=8000

# Entraînement
N_ROWS=6000
RANDOM_STATE=42
TEST_SIZE=0.2

# Optionnel : active le suivi MLflow du job d'entraînement
# MLFLOW_TRACKING_URI=http://mlflow:5000
# MLFLOW_EXPERIMENT=livraison-express
